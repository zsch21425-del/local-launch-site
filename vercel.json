{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "local-launch-site.vercel.app"
        }
      ],
      "destination": "https://locallaunchupstate.com/$1",
      "statusCode": 301
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ],
  "functions": {
    "api/contact.js": {
      "memory": 256,
      "maxDuration": 10
    },
    "api/visualize.js": {
      "memory": 256,
      "maxDuration": 60
    },
    "api/score.py": {
      "memory": 512,
      "maxDuration": 30,
      "runtime": "@vercel/python@18.0.0"
    },
    "api/search.py": {
      "memory": 512,
      "maxDuration": 30,
      "runtime": "@vercel/python@18.0.0"
    }
  }
}
